{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "w3c-web-hid"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "electron", "electron.vite.config.ts"]
}
